{
  "motion": 1,
  "meta": {
    "title": "Cookbook 15: a 150 s piece (looping grid background with a long credits crawl) that the service chunks across workers; renders byte-identically in one process or in chunks",
    "x-skills": {
      "expectWarnings": [
        "lint.crawl_duration_mismatch",
        "lint.text_outside_safe_area",
        "lint.offscreen_while_visible"
      ],
      "note": "The crawl sheet is taller than the frame; the whole-pixel speed changes the requested length slightly."
    }
  },
  "theme": {
    "use": "mitte/mono@1"
  },
  "data": {
