  "comps": {
    "main": {
      "size": [
        1920,
        1080
      ],
      "fps": 24,
      "duration": 150,
      "background": "$theme.color.bg",
      "layers": [
        {
          "id": "grid",
          "type": "component",
          "use": "mitte/bg.grid@1",
          "in": 0,
          "out": 150,
          "props": {
            "cell": 120,
            "speed": 10,
            "glow": 10
          }
        },
        {
          "id": "roll",
          "type": "component",
          "use": "mitte/credits.crawl@1",
          "in": 2,
          "out": 148,
          "props": {
            "sections": "$data.sections",
            "duration": 140,
            "font": "$theme.font.mono",
            "size": 30,
            "width": "70%"
          }
        }
      ]
    }
  },
  "output": {
    "format": "mp4",
    "codec": "h264",
    "quality": "high"
  }
}
