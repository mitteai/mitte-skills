{
  "motion": 1,
  "meta": {
    "title": "Captions: caption.highlight over footage on 9:16 with inline word timings, a square variant with one line",
    "x-skills": {
      "expectWarnings": [
        "lint.missing_exit",
        "lint.duration_mismatch"
      ],
      "note": "A caption instance ends at its last word (missing_exit on it is expected); in production `words` is `$data.@transcript.words` from a data asset, inline here so the check runs offline. duration_mismatch: the placeholder audio has no known length offline."
    }
  },
  "theme": {
    "use": "mitte/bold@1"
  },
  "assets": {
    "plate": {
      "src": "https://media.mitte.ai/u/p0/nimbus-plate.mp4",
      "type": "video"
    },
    "vo": {
      "src": "https://media.mitte.ai/u/p0/vo-fathom.wav",
      "type": "audio"
    }
  },
  "lint": {
    "platform": "tiktok"
  },
  "comps": {
    "main": {
      "size": [
        1080,
        1920
      ],
      "fps": 30,
      "duration": 6,
      "background": "#000000",
      "safe": "tiktok",
      "layers": [
        {
          "id": "plate",
          "type": "video",
          "asset": "plate",
          "fit": "cover",
          "mute": true
        },
        {
          "id": "grade",
          "type": "adjustment",
          "effects": [
            {
              "type": "stylize.vignette",
              "params": {
                "amount": -0.3
              }
            }
          ]
        },
        {
          "id": "captions",
          "type": "component",
          "use": "mitte/caption.highlight@1",
          "in": 0.6,
          "props": {
            "words": [
              {
                "text": "Ship",
                "start": 0.42,
                "end": 0.71
              },
              {
                "text": "faster",
                "start": 0.71,
                "end": 1.18
              },
              {
                "text": "with",
                "start": 1.3,
                "end": 1.44
              },
              {
                "text": "mitte.",
                "start": 1.44,
                "end": 1.95
              },
              {
                "text": "One",
                "start": 2.3,
                "end": 2.55
              },
              {
                "text": "document,",
                "start": 2.55,
                "end": 3.05
              },
              {
                "text": "every",
                "start": 3.15,
                "end": 3.4
              },
              {
                "text": "format.",
                "start": 3.4,
                "end": 3.95
              }
            ],
            "group": {
              "maxWords": 3,
              "maxChars": 18
            },
            "style": {
              "font": "$theme.font.display",
              "size": "$theme.type.size.3",
              "case": "upper",
              "fill": "#FFFFFF",
              "weight": 800,
              "stroke": {
                "color": "#000000",
                "width": 8
              }
            },
            "active": {
              "fill": "$theme.color.accent",
              "scale": 108
            },
            "position": "safe-bottom",
            "lines": 2
          }
        },
        {
          "id": "voice",
          "type": "audio",
          "asset": "vo",
          "in": 0.6,
          "fadeOut": 0.5
        }
      ]
    }
  },
  "variants": {
    "square": {
      "size": [
        1080,
        1080
      ],
      "safe": "square",
      "lint": {
        "platform": "none"
      },
      "override": {
        "captions": {
          "props": {
            "lines": 1,
            "group": {
              "maxWords": 2,
              "maxChars": 14
            }
          }
        }
      }
    },
    "landscape": {
      "size": [
        1920,
        1080
      ],
      "safe": "youtube",
      "lint": {
        "platform": "youtube"
      }
    }
  }
}
