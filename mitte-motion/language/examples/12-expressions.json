{
  "motion": 1,
  "meta": { "title": "Expressions: the object model, functions, randomness, selectors, idioms" },
  "comps": {
    "other": { "size": [400, 300], "fps": 30, "duration": 6, "layers": [ { "id": "dot", "type": "shape", "shape": "circle", "radius": 20, "fill": "#FFFFFF", "position": { "keys": [ { "t": 0, "v": [50, 150] }, { "t": 6, "v": [350, 150] } ] } } ] },
    "main": {
      "size": [1920, 1080], "fps": 30, "duration": 6, "background": "#0B0B0F",
      "markers": [ { "t": 1, "name": "hit" }, { "t": 3, "name": "hit2", "dur": 0.5 } ],
      "layers": [
        { "id": "ctl", "type": "null", "position": [0, 0], "effects": [
          { "id": "amount", "type": "control.slider", "params": { "value": { "keys": [ { "t": 0, "v": 0, "ease": "expo.out" }, { "t": 2, "v": 100 } ] } } },
          { "id": "tint", "type": "control.color", "params": { "value": "#FACC15" } },
          { "id": "pt", "type": "control.point", "params": { "value": [1200, 300] } },
          { "id": "on", "type": "control.checkbox", "params": { "value": true } } ] },
        { "id": "title", "type": "text", "text": { "value": "0", "expr": "var n = Math.round(linear(time, 0, 2, 0, 1250)); n.toLocaleString('de-DE') + ' Nutzer'" },
          "style": { "font": "Inter", "weight": 800, "size": 110, "fill": "#F5F5F7", "fontFeatures": { "tnum": 1 } }, "origin": "center", "position": [960, 200] },
        { "id": "plate", "type": "shape", "position": [960, 200], "contents": [
          { "type": "rect", "size": { "value": [100, 100], "expr": "var r = thisComp.layer('title').sourceRectAtTime(time, false); [r.width + 48, r.height + 24]" }, "roundness": 16 },
          { "type": "fill", "color": { "value": "#16161D", "expr": "thisComp.layer('ctl').effect('on')('value') ? value : hexToRgb('#333333')" } } ] },
        { "id": "spin", "type": "shape", "shape": "polygon", "sides": 3, "radius": 60, "fill": "#22D3EE", "position": [300, 500],
          "rotation": { "value": 0, "expr": "time * 120 + thisComp.layer('ctl').effect('amount')('value') / 2" } },
        { "id": "wig", "type": "shape", "shape": "circle", "radius": 40, "fill": "#F472B6", "position": { "value": [600, 500], "expr": "wiggle(2, 25)" } },
        { "id": "leader", "type": "shape", "shape": "circle", "radius": 24, "fill": "#F5F5F7", "position": { "keys": [ { "t": 0, "v": [900, 500] }, { "t": 2, "v": [1300, 700], "ease": "expo.out" }, { "t": 4, "v": [900, 900] } ] } },
        { "id": "follower", "type": "shape", "shape": "circle", "radius": 16, "fill": "#7C5CFF", "position": { "value": [0, 0], "expr": "thisComp.layer('leader').transform.position.valueAtTime(time - 0.15)" },
          "opacity": { "value": 100, "expr": "linear(length(thisComp.layer('leader').position, thisComp.layer(1).position), 0, 600, 100, 20)" } },
        { "id": "bounce", "type": "shape", "shape": "roundedRect", "size": [120, 120], "radius": 20, "fill": "#34D399", "origin": "center",
          "position": { "keys": [ { "t": 0.5, "v": [1500, 300], "ease": "power2.in" }, { "t": 1.2, "v": [1500, 700] } ],
                        "expr": "amp = .06; freq = 3; decay = 6;\nn = 0;\nif (numKeys > 0) {\n  n = nearestKey(time).index;\n  if (key(n).time > time) n--;\n}\nif (n == 0) { t = 0; } else { t = time - key(n).time; }\nif (n > 0 && t < 1) {\n  v = velocityAtTime(key(n).time - thisComp.frameDuration / 10);\n  value + v * amp * Math.sin(freq * t * 2 * Math.PI) / Math.exp(decay * t);\n} else {\n  value;\n}" } },
        { "id": "look", "type": "shape", "shape": "arrow", "from": [0, 0], "to": [80, 0], "head": 20, "stroke": { "color": "#FACC15", "width": 5 }, "position": [1200, 500],
          "rotation": { "value": 0, "expr": "var p = thisComp.layer('leader').position; var d = sub(p, position); radiansToDegrees(Math.atan2(d[1], d[0]))" } },
        { "id": "rnd", "type": "shape", "shape": "star", "points": 5, "outer": 30, "inner": 14, "fill": { "value": "#FFFFFF", "expr": "seedRandom(index, true); hslToRgb([random(), 0.8, 0.6, 1])" },
          "position": { "value": [1600, 500], "expr": "posterizeTime(6); seedRandom(3); value + [gaussRandom(-20, 20), noise(time) * 30]" },
          "scale": { "value": [100, 100], "expr": "var k = thisComp.marker.nearestKey(time); var s = Math.abs(time - k.time) < 0.2 ? 160 : 100; [s, s]" } },
        { "id": "masked", "type": "solid", "color": "#2A2A35", "size": [400, 200], "origin": "top-left", "position": [100, 800],
          "masks": [ { "id": "m", "mode": "add", "path": { "value": { "v": [[0, 0], [400, 0], [400, 200], [0, 200]], "closed": true },
                       "expr": "var w = 200 + 180 * Math.sin(time * 2); createPath([[0, 0], [w, 0], [w, 200], [0, 200]], [], [], true)" } } ] },
        { "id": "shapeRead", "type": "text", "text": { "value": "", "expr": "var p = thisComp.layer('ctl').effect('pt')('value'); var m = thisComp.marker.key('hit2'); 'pt ' + p[0].toFixed(0) + ' · ' + thisComp.layer('ring').name.toUpperCase() + ' · ' + [1, 2, 3].map(function (x) { return x * 2; }).join(',') + ' · ' + timeToTimecode(time) + ' · ' + m.comment + ' ' + m.duration + ' · ' + thisComp.layer(1).id + ' ' + thisComp.numLayers + ' ' + thisLayer.index + ' ' + (thisLayer.hasParent ? 'p' : 'np') + ' ' + Object.keys({ a: 1 }).length" },
          "style": { "font": "JetBrains Mono", "size": 32, "fill": "#8A8A99" }, "origin": "top-left", "position": [600, 820] },
        { "id": "ring", "type": "shape", "position": [1300, 900], "contents": [ { "type": "group", "id": "g", "contents": [
          { "type": "ellipse", "size": [160, 160] }, { "type": "stroke", "color": "#F5F5F7", "width": 8 },
          { "type": "trim", "id": "tr", "end": { "keys": [ { "t": 0, "v": 0, "ease": "expo.out" }, { "t": 2, "v": 100 } ] } } ] } ] },
        { "id": "sel", "type": "text", "text": "EXPRESSION SELECTOR", "style": { "font": "Inter", "weight": 700, "size": 56, "fill": "#F5F5F7" }, "paragraph": { "align": "center" }, "origin": "center", "position": [960, 1000],
          "animators": [ { "id": "a", "props": { "opacity": 0, "position": [0, 30] },
            "selectors": [ { "type": "expression", "by": "chars", "amount": "ease(time, textIndex * 0.05, textIndex * 0.05 + 0.5, 100, 0) * (selectorValue / 100)" } ] } ] },
        { "id": "nested", "type": "comp", "comp": "other", "origin": "center", "position": [1700, 900], "scale": { "value": [50, 50], "expr": "var d = comp('other').layer('dot').position; var s = 40 + d[0] / 10; [s, s]" } }
      ]
    }
  }
}
