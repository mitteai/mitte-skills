{ "motion": 1,
  "comps": { "main": { "size": [1280, 720], "fps": 30, "duration": 3, "background": "#0B0B0F",
    "layers": [
      { "id": "map", "type": "solid", "color": "#808080", "visible": false,
        "effects": [ { "id": "noise", "type": "generate.fractalNoise", "params": { "fractal": "basic", "scale": 120, "complexity": 3, "evolution": { "keys": [ { "t": 0, "v": 0 }, { "t": 3, "v": 180 } ] }, "composite": "replace" } } ] },
      { "id": "sky", "type": "solid", "color": "#000000",
        "effects": [ { "id": "ramp", "type": "generate.gradient", "params": { "type": "linear", "start": [0, 0], "end": [1280, 720], "gradient": { "stops": [[0, "#7C5CFF"], [0.5, "#22D3EE"], [1, "#F472B6"]] }, "composite": "replace" } },
                     { "id": "warp", "type": "distort.displacement", "params": { "map": "map", "mapSource": "effects", "horizontal": "red", "maxHorizontal": 30, "vertical": "green", "maxVertical": 30, "fit": "stretch" } } ] },
      { "id": "word", "type": "text", "text": "LIQUID", "origin": "center", "position": [640, 360],
        "style": { "font": "Inter", "weight": 800, "size": 170, "fill": "#F7F3E8" },
        "effects": [
          { "id": "turb", "type": "distort.turbulent", "params": { "amount": 12, "size": 80, "complexity": 2, "evolution": { "keys": [ { "t": 0, "v": 0 }, { "t": 3, "v": 360 } ] }, "cycleEvolution": true, "pinning": "all" } },
          { "id": "wave", "type": "distort.waveWarp", "params": { "waveType": "smoothNoise", "height": 4, "width": 120, "speed": 0.5 } },
          { "id": "bulge", "type": "distort.bulge", "params": { "height": 0 } },
          { "id": "twirl", "type": "distort.twirl", "params": { "angle": 0 } },
          { "id": "ripple", "type": "distort.ripple", "params": { "height": 0 } },
          { "id": "chroma", "type": "distort.lens", "params": { "fov": 0 } }
        ] },
      { "id": "pill", "type": "shape", "shape": "roundedRect", "size": [520, 160], "radius": 80, "fill": "#FFFFFF80",
        "position": { "keys": [ { "t": 0, "v": [300, 360], "ease": "power2.inOut" }, { "t": 3, "v": [980, 360] } ] },
        "effects": [ { "id": "glass", "type": "distort.glass",
          "params": { "bevelSize": 32, "bevelProfile": "squircle", "refraction": 1.45, "dispersion": 0.03, "frost": 6, "thickness": 30, "tint": "#FFFFFF14", "saturation": 115,
                      "specular": { "intensity": 0.7, "angle": -45, "size": 0.3, "rim": 40 }, "shadow": { "opacity": 25, "softness": 16, "offset": [0, 8] } } } ] },
      { "id": "card", "type": "shape", "shape": "roundedRect", "size": [300, 180], "radius": 12, "fill": "#2E3A59", "position": [200, 600],
        "effects": [
          { "id": "pin", "type": "distort.cornerPin", "params": { "topLeft": [20, 0], "topRight": [280, 30], "bottomLeft": [0, 180], "bottomRight": [300, 150] } },
          { "id": "kal", "type": "distort.kaleidoscope", "params": { "mirroring": "dia", "size": 50 }, "enabled": false },
          { "id": "mirror", "type": "distort.mirror", "params": { "angle": 0 }, "enabled": false },
          { "id": "polar", "type": "distort.polar", "params": { "interpolation": 0 } },
          { "id": "tile", "type": "distort.motionTile", "params": { "outputWidth": 100 } },
          { "id": "mag", "type": "distort.magnify", "params": { "magnification": 100 } },
          { "id": "sph", "type": "distort.spherize", "params": { "radius": 0 } },
          { "id": "off", "type": "distort.offset", "params": { "shift": [0, 0] } },
          { "id": "xf", "type": "distort.transform", "params": { "rotation": { "keys": [ { "t": 0, "v": 0 }, { "t": 3, "v": 90 } ] }, "useCompShutterAngle": true } },
          { "id": "mesh", "type": "distort.meshWarp", "params": { "rows": 3, "columns": 3 }, "enabled": false },
          { "id": "bez", "type": "distort.bezierWarp", "params": {}, "enabled": false },
          { "id": "liq", "type": "distort.liquify", "params": { "strokes": [ { "points": [[40, 40], [200, 120]], "size": 64, "pressure": 50, "mode": "push" } ], "distortion": 0 } },
          { "id": "warpp", "type": "distort.warp", "params": { "style": "arc", "bend": 0 } },
          { "id": "bender", "type": "distort.ccBender", "params": { "amount": 0 } },
          { "id": "slant", "type": "distort.ccSlant", "params": { "slant": 0 } },
          { "id": "smear", "type": "distort.ccSmear", "params": { "reach": 0 } },
          { "id": "split", "type": "distort.ccSplit", "params": { "split": 0 } },
          { "id": "split2", "type": "distort.ccSplit2", "params": { "split1": 0, "split2": 0 } },
          { "id": "tiler", "type": "distort.ccTiler", "params": { "scale": 100 } },
          { "id": "grid", "type": "distort.ccGriddler", "params": { "tileSize": 10 }, "enabled": false },
          { "id": "scat", "type": "distort.ccScatterize", "params": { "scatter": 0 } },
          { "id": "pulse", "type": "distort.ccRipplePulse", "params": { "pulseLevel": { "keys": [ { "t": 0, "v": 0 }, { "t": 1, "v": 1 } ] }, "amplitude": 60 }, "enabled": false },
          { "id": "flo", "type": "distort.ccFlo", "params": { "amount1": 0, "amount2": 0 } },
          { "id": "bend", "type": "distort.ccBend", "params": { "bend": 0 } },
          { "id": "blob", "type": "distort.ccBlobbylize", "params": { "softness": 6 }, "enabled": false },
          { "id": "reshape", "type": "distort.reshape", "params": { "percent": 0 } },
          { "id": "smearp3", "type": "distort.smear", "params": { "stretch": 0 } }
        ] }
    ] } } }
