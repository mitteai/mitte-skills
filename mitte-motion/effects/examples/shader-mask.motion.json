       "params": {
        "code": "fn effect(uv: vec2f, t: f32) -> vec4f {\n  let c = textureSampleLevel(input, samp, uv, 0.0);\n  // the second layer is read over ITS OWN rect: here it is comp-sized, as the target is, so uv lines up\n  let m = textureSampleLevel(input1, samp, uv, 0.0).a;\n  let k = select(m, 1.0 - m, params.invert > 0.5);\n  return c * k;  // every channel scaled: the result stays premultiplied\n}",
        "params": {
