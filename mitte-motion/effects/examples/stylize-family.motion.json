{ "motion": 1,
  "comps": { "main": { "size": [1280, 720], "fps": 30, "duration": 3, "background": "#F4F1EA",
    "markers": [ { "t": 1.0, "name": "beat1" }, { "t": 2.0, "name": "beat2" } ],
    "layers": [
      { "id": "plate", "type": "solid", "color": "#000000",
        "effects": [ { "id": "noise", "type": "generate.fractalNoise", "params": { "fractal": "turbulentSmooth", "scale": 160, "contrast": 140, "composite": "replace" } },
                     { "id": "map", "type": "color.gradientMap", "params": { "gradient": { "stops": [[0, "#1B1F3B"], [0.6, "#D7263D"], [1, "#FFB347"]] } } },
                     { "id": "half", "type": "stylize.halftone", "params": { "mode": "duotone", "cellSize": 9, "ink": "#1B1F3B", "secondInk": "#D7263D", "paper": "#F4F1EA", "shape": "dot", "blend": 100 } } ] },
      { "id": "sticker", "type": "text", "text": "STICKER", "origin": "center", "position": [640, 300],
        "style": { "font": "Inter", "weight": 800, "size": 150, "fill": "#D7263D" },
        "effects": [
          { "id": "rough", "type": "stylize.roughenEdges", "params": { "edgeType": "roughen", "border": 6, "scale": 60, "evolution": { "keys": [ { "t": 0, "v": 0 }, { "t": 3, "v": 360, "ease": "steps(18)" } ] } } },
          { "id": "outline", "type": "stylize.outline", "params": { "width": 10, "color": "#FFFFFF", "position": "outside" } },
          { "id": "shadow", "type": "stylize.dropShadow", "params": { "distance": 8, "softness": 12, "opacity": 45 } },
          { "id": "long", "type": "stylize.longShadow", "params": { "length": 0 } },
          { "id": "emboss", "type": "stylize.emboss", "params": { "blend": 100 } },
          { "id": "edges", "type": "stylize.findEdges", "params": { "blend": 100 } }
        ] },
      { "id": "glitchy", "type": "text", "text": "GLITCH", "origin": "center", "position": [640, 560],
        "style": { "font": "Inter", "weight": 800, "size": 120, "fill": "#1B1F3B" },
        "effects": [
          { "id": "glitch", "type": "stylize.glitch", "params": { "blockSize": [120, 10], "blockShift": 50, "channelShift": 12, "colorBlocks": true, "seed": 3,
              "amount": { "keys": [ { "t": 0.95, "v": 0 }, { "t": 1.0, "v": 80 }, { "t": 1.15, "v": 80 }, { "t": 1.2, "v": 0 }, { "t": 1.95, "v": 0 }, { "t": 2.0, "v": 80 }, { "t": 2.15, "v": 80 }, { "t": 2.2, "v": 0 } ] } } },
          { "id": "split", "type": "stylize.rgbSplit", "params": { "red": [-6, 0], "blue": [6, 0] } },
          { "id": "chroma", "type": "stylize.chromatic", "params": { "amount": 0 } },
          { "id": "scan", "type": "stylize.scanlines", "params": { "density": 180, "opacity": 25, "mask": "aperture" } },
          { "id": "vhs", "type": "stylize.vhs", "params": { "amount": 0 } },
          { "id": "sort", "type": "stylize.pixelSort", "params": { "threshold": [0.8, 0.2] } },
          { "id": "dither", "type": "stylize.dither", "params": { "method": "bayer4", "palette": "gameboy", "pixelSize": 3 }, "enabled": false },
          { "id": "pix", "type": "stylize.pixelate", "params": { "size": 6, "shape": "hexagon" }, "enabled": false },
          { "id": "mosaic", "type": "stylize.mosaic", "params": { "horizontalBlocks": 40, "verticalBlocks": 24 }, "enabled": false },
          { "id": "scatter", "type": "stylize.scatter", "params": { "amount": 0 } },
          { "id": "postedge", "type": "stylize.posterizeEdges", "params": { "levels": 6 }, "enabled": false },
          { "id": "glowedge", "type": "stylize.glowEdges", "params": { "width": 2 }, "enabled": false },
          { "id": "cartoon", "type": "stylize.cartoon", "params": { "render": "fill" }, "enabled": false },
          { "id": "brush", "type": "stylize.brushStrokes", "params": { "blend": 100 } },
          { "id": "ascii", "type": "stylize.ascii", "params": { "cellSize": 10 }, "enabled": false },
          { "id": "tex", "type": "stylize.texturize", "params": { "texture": "plate", "placement": "stretch" }, "enabled": false },
          { "id": "block", "type": "stylize.ccBlockLoad", "params": { "completion": 0 } },
          { "id": "burn", "type": "stylize.ccBurnFilm", "params": { "burn": 0 } },
          { "id": "glass", "type": "stylize.ccGlass", "params": { "height": 50 }, "enabled": false },
          { "id": "plastic", "type": "stylize.ccPlastic", "params": { "height": 25 }, "enabled": false },
          { "id": "hex", "type": "stylize.ccHexTile", "params": { "radius": 50 }, "enabled": false },
          { "id": "smoothie", "type": "stylize.ccMrSmoothie", "params": {}, "enabled": false },
          { "id": "repe", "type": "stylize.ccRepeTile", "params": { "expandRight": 0 } },
          { "id": "thr", "type": "stylize.ccThresholdRgb", "params": { "blendWithOriginal": 100 } },
          { "id": "median", "type": "stylize.median", "params": { "radius": 0 } },
          { "id": "dust", "type": "stylize.dustScratches", "params": { "radius": 0 } },
          { "id": "na", "type": "stylize.noiseAlpha", "params": { "amount": 0 } },
          { "id": "nhls", "type": "stylize.noiseHls", "params": { "lightness": 0 } },
          { "id": "nhlsa", "type": "stylize.noiseHlsAuto", "params": { "lightness": 0 } },
          { "id": "rg", "type": "stylize.removeGrain", "params": { "noiseReduction": { "amount": 0 } } }
        ] },
      { "id": "finish", "type": "adjustment",
        "effects": [
          { "id": "grain", "type": "stylize.grain", "params": { "preset": "kodak5219", "amount": 25, "rate": 24 } },
          { "id": "noise", "type": "stylize.noise", "params": { "amount": 0 } },
          { "id": "vig", "type": "stylize.vignette", "params": { "amount": -0.35, "feather": 60 } },
          { "id": "ccvig", "type": "stylize.ccVignette", "params": { "amount": 0 } },
          { "id": "bars", "type": "stylize.letterbox", "params": { "aspect": 2.39, "color": "#000000" } }
        ] }
    ] } } }
